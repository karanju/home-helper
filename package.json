{
  "name": "home-helper",
  "version": "1.0.0",
  "description": "Age-aware household helper for Build for Everyone Hackathon (Google + k-ID)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix client run build",
    "start": "node server.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "node server.js & npm --prefix client run dev",
    "test": "node --test ai/*.test.js"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.6.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
