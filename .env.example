# Port for Express server (Cloud Run defaults to 8080)
PORT=8080

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# k-ID Secret Key (starts with kgs_test_)
# Copy from your Kai dashboard into .env (never commit your actual key)
KID_SECRET_KEY=kgs_test_your_secret_key_here

# Puter auth token for kid picture guides (server-side; uses this Puter account's allowance)
PUTER_AUTH_TOKEN=your_puter_auth_token_here

# Firebase (Google sign-in + Firestore). Leave FIREBASE_PROJECT_ID empty to run without accounts.
# Web app config from Firebase console > Project settings > Your apps (these are public values)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Service account key for the server (Project settings > Service accounts > Generate new private key).
# Keep the JSON outside this repo. Not needed on Cloud Run, which uses the service's own identity.
GOOGLE_APPLICATION_CREDENTIALS=

# k-ID publishable key used by the browser app (safe to expose in the client bundle)
VITE_KID_PUBLISHABLE_KEY=kgp_test_your_publishable_key_here

# Modulate transcription API key (keep the real value in .env or your deployment secrets)
MODULATE_API_KEY=your_modulate_api_key_here
